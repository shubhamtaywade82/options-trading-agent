# ---------------------------------------------------------------------------
# Mode. Market data is always the live Dhan feed. Only the order venue differs.
#   paper   = simulated orders: PostgreSQL venue, or a running paper_exchange server (PAPER_BACKEND). Needs DATABASE_URL. Default.
#   sandbox = orders sent to the Dhan SANDBOX account (SDK hybrid mode). Needs DHAN_SANDBOX_* and both stores.
#   live    = real orders on the Dhan production account. Needs the acknowledgement below and both stores.
# Precedence: a YAML config file overrides the same keys in this file. npm run dev:paper loads config.paper.yml,
# so for the keys that file sets, this file has no effect while paper runs under dev:paper.
# ---------------------------------------------------------------------------
MODE=paper
LIVE_TRADING_ACK=

# Dhan credentials. Required in both modes: market data is always live.
# Preferred: OTP login. At startup the agent exchanges PIN + a fresh TOTP code for an access token,
# then renews it before expiry. Set DHAN_PIN and DHAN_TOTP_SECRET together, and leave DHAN_ACCESS_TOKEN empty.
# DHAN_PIN and DHAN_TOTP_SECRET grant account access. Never commit them, paste them into issues, or log them.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Alternative: a static token copied from the Dhan portal. It expires and is not renewed.
# Use only when DHAN_PIN and DHAN_TOTP_SECRET are both unset.
DHAN_ACCESS_TOKEN=
# OTP logins are cached on disk (default ~/.dhanhq) so smoke:live and dev:paper share one token until it expires or is renewed.
# DHAN_TOKEN_CACHE_DIR=
# DHAN_BASE_URL=

# Sandbox order account. Used only when MODE=sandbox. Market data never uses these; it uses DHAN_* above.
# The SDK sends orders, positions, funds and controls to sandbox.dhan.co on these credentials.
# DHAN_SANDBOX_BASE_URL is optional; when set it must be https and must not be api.dhan.co.
# DHAN_SANDBOX_CLIENT_ID=
# DHAN_SANDBOX_ACCESS_TOKEN=
# DHAN_SANDBOX_BASE_URL=

# Paper order venue. "postgres" (default) simulates fills in this database.
# "exchange" sends paper orders to a running paper_exchange server (github.com/shubhamtaywade82/paper_exchange).
# PAPER_BACKEND=postgres
# PAPER_EXCHANGE_URL=http://127.0.0.1:3100
# PAPER_EXCHANGE_API_KEY=
# PAPER_EXCHANGE_ACCOUNT_ID=   # defaults to DHAN_CLIENT_ID

# Index symbols to trade, comma separated. Supported: NIFTY, BANKNIFTY, FINNIFTY, MIDCPNIFTY (NSE_FNO), SENSEX (BSE_FNO).
UNDERLYINGS=NIFTY

# ---------------------------------------------------------------------------
# Capital and risk. Every trade is sized so its stop-out loss fits the budget.
# MAX_RISK_PER_TRADE_PCT must not exceed MAX_DAILY_LOSS_PCT.
# CAPITAL_INR is a ceiling: sizing uses the smaller of it and the broker's available funds.
# One lot must fit the budget or the signal is dropped (RISK_BUDGET_TOO_SMALL):
#   premium × STOP_LOSS_PCT/100 × lot size ≤ CAPITAL_INR × MAX_RISK_PER_TRADE_PCT/100
#   e.g. NIFTY ATM ₹120 × 0.30 × 65 ≈ ₹2,340 needs CAPITAL_INR ≥ ₹2.34L at 1%.
# ---------------------------------------------------------------------------
CAPITAL_INR=300000
MAX_RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=3
# The daily-loss brake: entries stop and positions flatten at the limit. Press d in the cockpit to toggle it.
ENFORCE_DAILY_LOSS=true
MAX_OPEN_POSITIONS=1
MAX_POSITIONS_PER_UNDERLYING=2
MAX_POSITIONS_PER_SIDE=1
# A CE and a PE on indices that move together pay decay and spread twice. The paper profile sets false.
ALLOW_OPPOSING_SIDES=true
MAX_TRADES_PER_DAY=3
MAX_LOTS_PER_ORDER=1
# Cooldown per underlying after an exit before the next entry, in seconds.
COOLDOWN_SECONDS=300
# All-in risk (adverse fill, stop slippage and charges) beside the planned risk: off, shadow or enforce.
# shadow journals the all-in figure and decides on the planned one. enforce decides on all-in and, in live mode,
# also needs ALL_IN_RISK_LIVE_ACK set to the phrase below. The roadmap has not approved live enforce.
ALL_IN_RISK_POLICY=off
# ALL_IN_RISK_LIVE_ACK=I_APPROVE_ALL_IN_RISK_ENFORCEMENT

# ---------------------------------------------------------------------------
# Contract selection. Starting points only: tune per index and per market regime.
# ---------------------------------------------------------------------------
MIN_DAYS_TO_EXPIRY=0
MAX_DAYS_TO_EXPIRY=4
EXPIRY_DAY_ENTRY_CUTOFF=13:30
# 0 = ATM, positive = further OTM, negative = further ITM.
STRIKE_OFFSET_STEPS=0
MAX_SPREAD_PCT=2
MIN_OPEN_INTEREST=10000
MIN_VOLUME=1000
# Live entries are LIMIT orders at ask × (1 + this %). Stop, target and size are computed from that limit,
# so a fill above the ask cannot widen the risk. Unfilled within ORDER_TIMEOUT_MS: cancelled.
ENTRY_LIMIT_BUFFER_PCT=1

# ---------------------------------------------------------------------------
# Exits and session (IST). Stop loss is mandatory on every entry.
# ---------------------------------------------------------------------------
STOP_LOSS_PCT=30
TARGET_RR=2
MAX_HOLD_MINUTES=20
# Percentage of entry premium to step up the stop (e.g. 15 = 15%). 0 disables trailing. The paper profile uses 8.
# TRAILING_JUMP_PCT=0
# R-multiple gain to move SL to entry breakeven (default: 1 for 1R).
BREAKEVEN_AT_RR=1
# Set true for an uncapped runner with no fixed target. The paper profile sets false.
# RUNNER_MODE=false
ENTRY_START=09:30
ENTRY_END=14:30
FLATTEN_BY=15:05

# ---------------------------------------------------------------------------
# Strategy. STRATEGY_POSTURE sets how many confirmations a signal needs:
#   scout     = fastest entries, no multi-indicator agreement. The paper profile uses this.
#   aligned   = ORB close outside the range, plus EMA alignment on the closed bar (default).
#   confirmed = aligned, plus a confirmation bar.
# ENABLED_STRATEGIES is a comma-separated list of families: range, trend, ema_cross, momentum, continuation, prev_day.
# prev_day is research-only and is off unless named here.
# BAR_MINUTES must be one of 1, 5, 15, 25, 60.
# ---------------------------------------------------------------------------
STRATEGY_POSTURE=aligned
# ENABLED_STRATEGIES=range,trend,ema_cross,momentum,continuation
BAR_MINUTES=5
ORB_MINUTES=15
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3
EMA_FAST=9
EMA_SLOW=21
WARMUP_DAYS=5
MAX_BARS_SINCE_FLIP=3
MIN_DISTANCE_ATR=0.5

# ---------------------------------------------------------------------------
# Option-chain and market-context gates. Both are off by default; the paper profile turns them on.
# CHAIN_ANALYSIS: refuses a CE that sits within the headroom below major call-OI resistance (a PE below put-OI
# support) and refuses extreme PCR. CONTEXT_FILTER: day trend, market structure and chain bias must agree with the side.
# CONTEXT_STRUCTURE_EXIT: exits a held side when market structure shifts against it.
# ---------------------------------------------------------------------------
CHAIN_ANALYSIS_ENABLED=false
CHAIN_ANALYSIS_MIN_HEADROOM_PTS=15
CONTEXT_FILTER_ENABLED=false
CONTEXT_STRUCTURE_EXIT=false

# ---------------------------------------------------------------------------
# Feed and clock.
# DHAN_EPOCH_IST_SHIFTED=false (default): Dhan epoch seconds are true UTC.
# DHAN_EPOCH_IST_SHIFTED=true: epoch seconds encode IST wall-clock, 19800 s ahead of UTC.
# A wrong value shifts every bar by 5h30m. Startup refuses to run in that case (bars ahead of
# the clock, or far behind it on a session day), so the setting is checked against live data.
# ---------------------------------------------------------------------------
FEED_STALE_MS=5000
# Dhan market WebSocket mode: ticker (default), quote, or full. Index spots (IDX_I) do not receive packets in full mode.
# DHAN_MARKET_FEED_MODE=ticker
DHAN_EPOCH_IST_SHIFTED=false
# The WebSocket feed's last-trade time has its own convention: Dhan stamps IST wall-clock there (measured on
# ticker and full packets), so the default is true. A wrong value logs "feed LTT is ahead of the clock".
DHAN_FEED_IST_SHIFTED=true
RECONCILE_INTERVAL_MS=5000
ORDER_TIMEOUT_MS=30000

# Paper venue only: slippage added to entries and subtracted from exits.
# Default 25 bps, about half the spread on liquid ATM index options. Exits fill at the last price otherwise.
PAPER_SLIPPAGE_BPS=25

# Engage the broker kill switch on a daily-loss breach, once no position is open. Halts always engage it.
BROKER_KILL_SWITCH_ON_BREACH=true

# ---------------------------------------------------------------------------
# Operator alerts (daily-loss breaches, kill switch events, order rejections, halts).
# Delivery is best-effort and never blocks or fails trading paths.
# ---------------------------------------------------------------------------
# Plain-text webhook target (e.g. https://ntfy.sh/my-topic)
# ALERT_WEBHOOK_URL=
# Telegram Bot alerts (formatted with @nemesis-oss/tg-format native entities)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# LLM advisor via @nemesis-oss/ollama-sdk. Veto-only: it can SKIP an entry, never create one.
# Any failure is treated as SKIP. Local host: http://127.0.0.1:11434. Cloud: https://ollama.com with an API key.
# ---------------------------------------------------------------------------
LLM_ADVISOR=off
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=
LLM_TIMEOUT_MS=8000

# Terminal cockpit. Default on when stdout is a terminal. Set UI=off for plain log lines.
# UI=off
# Append-only JSONL audit trail: one events-YYYY-MM-DD.jsonl file per IST trading day.
# It is the local write-ahead log. Every line carries its run, sequence, mode and client. Do not delete it mid-session.
EVENT_LOG_DIR=data/journal
# CONFIG_FILE=config.paper.yml   # set by npm run dev:paper; the keys it sets override this file

# ---------------------------------------------------------------------------
# Persistence. Paper requires DATABASE_URL (its wallet and positions are stored there).
# Sandbox and live require DATABASE_URL and REDIS_URL. Credentials in these URLs are never logged.
# ---------------------------------------------------------------------------
# PostgreSQL 16: the trading ledger, the run registry, and the trading lease (one live run per client).
# DATABASE_URL=postgres://agent:change-me@127.0.0.1:5432/trading?sslmode=require
# Password for the local PostgreSQL in docker-compose.yml. Required there; choose your own value.
POSTGRES_PASSWORD=
# POSTGRES_MAX_CONNECTIONS=5
# Redis 7: the account rate gate for option-chain calls and the contract cache. Not a trading authority.
# REDIS_URL=rediss://:change-me@cache.internal:6380/0
# How long the trading lease lasts without renewal. A crashed run's lease ends this long after its last renewal,
# and a new holder also waits ORDER_TIMEOUT_MS.
# LEASE_TTL_MS=30000
# Names this host in the run registry. Defaults to the hostname.
# INSTANCE_ID=live-host-1

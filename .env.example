# ---------------------------------------------------------------------------
# Mode. paper = simulated fills on live Dhan market data (default).
#       live  = real super orders on DhanHQ. Requires the acknowledgement below.
# ---------------------------------------------------------------------------
MODE=paper
LIVE_TRADING_ACK=

# Dhan credentials. Required in both modes: market data is always live.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# DHAN_BASE_URL=

# Index symbols to trade, comma separated. Supported: NIFTY, BANKNIFTY, FINNIFTY, MIDCPNIFTY (NSE_FNO), SENSEX (BSE_FNO).
UNDERLYINGS=NIFTY

# ---------------------------------------------------------------------------
# Capital and risk. Every trade is sized so its stop-out loss fits the budget.
# MAX_RISK_PER_TRADE_PCT must not exceed MAX_DAILY_LOSS_PCT.
# ---------------------------------------------------------------------------
CAPITAL_INR=100000
MAX_RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=3
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=3
MAX_LOTS_PER_ORDER=1
# Cooldown per underlying after an exit before the next entry, in seconds.
COOLDOWN_SECONDS=300

# ---------------------------------------------------------------------------
# Contract selection. Starting points only: tune per index and per market regime.
# ---------------------------------------------------------------------------
MIN_DAYS_TO_EXPIRY=0
EXPIRY_DAY_ENTRY_CUTOFF=13:30
# 0 = ATM, positive = further OTM, negative = further ITM.
STRIKE_OFFSET_STEPS=0
MAX_SPREAD_PCT=2
MIN_OPEN_INTEREST=10000
MIN_VOLUME=1000

# ---------------------------------------------------------------------------
# Exits and session (IST). Stop loss is mandatory on every entry.
# ---------------------------------------------------------------------------
STOP_LOSS_PCT=30
TARGET_RR=2
MAX_HOLD_MINUTES=20
ENTRY_START=09:30
ENTRY_END=14:30
FLATTEN_BY=15:05

# ---------------------------------------------------------------------------
# Strategy (ORB breakout confirmed by SuperTrend and EMA alignment on closed bars).
# BAR_MINUTES must be one of 1, 5, 15, 25, 60.
# ---------------------------------------------------------------------------
BAR_MINUTES=5
ORB_MINUTES=15
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3
EMA_FAST=9
EMA_SLOW=21
WARMUP_DAYS=5

# ---------------------------------------------------------------------------
# Feed and clock.
# DHAN_EPOCH_IST_SHIFTED=false (default): Dhan epoch seconds are true UTC.
# DHAN_EPOCH_IST_SHIFTED=true: epoch seconds encode IST wall-clock, 19800 s ahead of UTC.
# A wrong value shifts every bar by 5h30m. Startup refuses to run in that case (bars ahead of
# the clock, or far behind it on a session day), so the setting is checked against live data.
# ---------------------------------------------------------------------------
FEED_STALE_MS=5000
DHAN_EPOCH_IST_SHIFTED=false
RECONCILE_INTERVAL_MS=5000
ORDER_TIMEOUT_MS=30000

# Paper venue only: slippage added to entries and subtracted from exits.
PAPER_SLIPPAGE_BPS=0

# On any halt (unknown order state, broker mismatch, daily-loss breach), disengage the broker kill switch.
BROKER_KILL_SWITCH_ON_BREACH=true

# ---------------------------------------------------------------------------
# LLM advisor via @nemesis-oss/ollama-sdk. Veto-only: it can SKIP an entry, never create one.
# Any failure is treated as SKIP. Local host: http://127.0.0.1:11434. Cloud: https://ollama.com with an API key.
# ---------------------------------------------------------------------------
LLM_ADVISOR=off
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=
LLM_TIMEOUT_MS=8000

# Append-only JSONL audit trail.
EVENT_LOG_PATH=data/events.jsonl

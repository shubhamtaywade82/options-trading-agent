  "cards": [
    {
      "dot": "cyan",
      "title": "Append-only by trigger",
      "items": [
        "trade_events, paper_orders, paper_wallet_entries and paper_withdrawals reject UPDATE, DELETE and TRUNCATE",
        "A closed paper position cannot be reopened or edited"
      ]
    },
    {
      "dot": "amber",
      "title": "Not foreign keys, by design",
      "items": [
        "paper_wallet_entries.correlation_id is unique but has no foreign key since migration 005",
        "Withdrawal entries carry WITHDRAWAL:<period> instead of an order id"
      ]
    },
    {
      "dot": "rose",
      "title": "Money types",
      "items": [
        "Cash is numeric(18,2) rupees; prices are numeric(14,4)",
        "The view v_closed_trades is derived from trade_events and is not drawn"
      ]
    }

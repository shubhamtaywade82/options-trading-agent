{
  "name": "inkui-agent-trade",
  "version": "2.4.1",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "bin": {
    "agent-trade": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "dev:paper": "MODE=paper tsx src/index.tsx",
    "dev:live": "MODE=live tsx src/index.tsx",
    "build": "tsc",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "backtest": "tsx scripts/backtest.ts",
    "e2e:paper-exchange": "tsx scripts/e2e-paper-exchange.ts",
    "sweep:struct-liq": "tsx scripts/struct-liq-sweep.ts",
    "research:conditional": "tsx scripts/conditional-edge.ts",
    "research:microstructure": "tsx scripts/microstructure-state.ts",
    "research:golden": "tsx scripts/golden.ts",
    "research:dashboard": "tsx scripts/research-dashboard.ts",
    "self-improve": "tsx scripts/self-improve.ts",
    "self-improve:status": "tsx scripts/self-improve.ts --status",
    "self-improve:events": "tsx scripts/self-improve.ts --events",
    "self-improve:metrics": "tsx scripts/self-improve.ts --metrics"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@nemesis-oss/binance-sdk": "3.0.0",
    "@nemesis-oss/ollama-sdk": "^1.8.0",
    "binance": "^2.15.22",
    "chalk": "^5.3.0",
    "cli-truncate": "^4.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "ink-select-input": "^6.2.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
